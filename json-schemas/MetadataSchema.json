{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://amp-als.org/schemas/MetadataSchema",
  "title": "MetadataSchema",
  "type": "object",
  "description": "Template for defining metadata schemas that document the structure, data types, and valid values for clinical and omics metadata files. Also supports dataset-level citation metadata per NIH CADR requirements.",
  "additionalProperties": {},
  "properties": {
    "attributes": {
      "description": "List of metadata attributes/columns defined in this schema",
      "items": {
        "additionalProperties": false,
        "description": "Definition of a single metadata attribute/column including its data type, valid values, and validation rules.",
        "properties": {
          "dataType": {
            "description": "Data type of this attribute",
            "title": "DataTypeEnum",
            "type": "string",
            "anyOf": [
              {
                "enum": [
                  "string",
                  "integer",
                  "float",
                  "date",
                  "datetime",
                  "boolean",
                  "enum"
                ]
              },
              {
                "const": ""
              }
            ]
          },
          "description": {
            "description": "Detailed description of what this attribute represents",
            "type": "string"
          },
          "examples": {
            "description": "Example values to help users understand this attribute",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "name": {
            "description": "Name of the metadata attribute/column",
            "type": "string"
          },
          "required": {
            "description": "Whether this attribute must be present in the data",
            "type": "boolean"
          },
          "validValues": {
            "description": "List of allowed values for enumerated attributes. Only applicable when dataType is \"enum\".",
            "items": {
              "additionalProperties": false,
              "description": "Allowed value for an enumerated attribute, including a description of what the value means.",
              "properties": {
                "description": {
                  "description": "What this value means or represents",
                  "type": "string"
                },
                "value": {
                  "description": "The actual allowed value",
                  "type": "string"
                }
              },
              "required": [
                "value",
                "description"
              ],
              "title": "ValidValue",
              "type": "object"
            },
            "type": "array"
          },
          "validationRules": {
            "description": "Optional validation constraints or rules for this attribute (e.g., \"Must be between 1900 and current year\")",
            "type": "string"
          }
        },
        "required": [
          "name",
          "description",
          "dataType"
        ],
        "title": "MetadataAttribute",
        "type": "object"
      },
      "type": "array"
    },
    "citationRecommendation": {
      "description": "Recommended citation format for this dataset",
      "type": "string"
    },
    "conformsTo": {
      "description": "URIs of community metadata standards this schema conforms to (e.g., DataCite, Dublin Core, DCAT, Schema.org)",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "contactEmail": {
      "description": "Email address for dataset inquiries",
      "type": "string"
    },
    "contactName": {
      "description": "Name of person/organization to contact for questions",
      "type": "string"
    },
    "contributor": {
      "description": "Institution or person responsible for collecting and managing the files and records in the resource.",
      "items": {
        "type": "string"
      },
      "title": "Contributor(s)",
      "type": "array"
    },
    "creator": {
      "description": "Properly formatted name of the organization or person that is creator of the resource (e.g. \"Sage Bionetworks\" or \"John Doe\"), not an id.",
      "items": {
        "type": "string"
      },
      "title": "Creator",
      "type": "array"
    },
    "curationLevel": {
      "description": "Level of data processing and curation applied to this entity.",
      "items": {
        "description": "Level of data processing and curation applied to a dataset or file",
        "title": "CurationLevelEnum",
        "type": "string",
        "anyOf": [
          {
            "enum": [
              "Raw",
              "Processed",
              "Analyzed",
              "Integrated",
              "tier1",
              "tier2",
              "tier3",
              "Standardized",
              "Non-Standardized",
              "Unknown"
            ]
          },
          {
            "const": ""
          }
        ]
      },
      "title": "Curation Level",
      "type": "array"
    },
    "dataType": {
      "description": "Type(s) of metadata this file represents (e.g., data dictionary, mapping file, schema documentation).",
      "items": {
        "description": "Data that provides information about other data",
        "title": "Metadata",
        "type": "string",
        "anyOf": [
          {
            "enum": [
              "Descriptive Metadata",
              "Structural Metadata",
              "Administrative Metadata",
              "Reference Metadata",
              "Statistical Metadata",
              "Legal Metadata",
              "Workflow Metadata",
              "Mapping File",
              "Data Dictionary",
              "Aggregate Metadata"
            ]
          },
          {
            "const": ""
          }
        ]
      },
      "type": "array"
    },
    "dataUseModifiers": {
      "description": "Data Use Ontology (DUO) codes specifying conditions under which this resource may be used.",
      "items": {
        "description": "Access type and Data Use Ontology (DUO) codes specifying how and under what conditions the data may be accessed and used.",
        "title": "DataUseModifierEnum",
        "type": "string",
        "anyOf": [
          {
            "enum": [
              "open",
              "controlled",
              "private",
              "embargo",
              "GRU",
              "HMB",
              "DS",
              "NCU",
              "NPUNCU",
              "US"
            ]
          },
          {
            "const": ""
          }
        ]
      },
      "title": "Data Use Modifiers",
      "type": "array"
    },
    "dateCreated": {
      "description": "Date the dataset was originally created (YYYY-MM-DD)",
      "format": "date",
      "type": "string"
    },
    "dateModified": {
      "description": "Date the dataset was last modified (YYYY-MM-DD)",
      "format": "date",
      "type": "string"
    },
    "datePublished": {
      "description": "Date the dataset was published (YYYY-MM-DD)",
      "format": "date",
      "type": "string"
    },
    "description": {
      "description": "Text describing a resource.",
      "type": "string"
    },
    "fileFormat": {
      "description": "Defined format of the data file, typically corresponding to extension, but sometimes indicating more general group of files produced by the same tool or software.",
      "items": {
        "description": "",
        "title": "FileFormatEnum",
        "type": "string",
        "anyOf": [
          {
            "enum": [
              "7z",
              "DICOM",
              "MATLAB data",
              "MATLAB script",
              "NWB",
              "PAR",
              "Python script",
              "R script",
              "RCC",
              "RData",
              "REC",
              "SDAT",
              "SPAR",
              "Sentrix descriptor file",
              "ab1",
              "abf",
              "ADAT",
              "ai",
              "avi",
              "bai",
              "bam",
              "bash script",
              "bcf",
              "bed",
              "bed broadPeak",
              "bed gappedPeak",
              "bed narrowPeak",
              "bedgraph",
              "bgzip",
              "bigwig",
              "bmp",
              "bpm",
              "cel",
              "chp",
              "cnn",
              "cnr",
              "cns",
              "cram",
              "crai",
              "csi",
              "csv",
              "ctab",
              "czi",
              "dat",
              "dna",
              "doc",
              "docker image",
              "dup",
              "edat3",
              "excel",
              "fasta",
              "fastq",
              "fcs",
              "fig",
              "flagstat",
              "gb",
              "gct",
              "gff3",
              "gtf",
              "gzip",
              "hdf5",
              "hdr",
              "hic",
              "html",
              "hyperlink",
              "idat",
              "idx",
              "img",
              "jpg",
              "js",
              "json",
              "lif",
              "locs",
              "maf",
              "md",
              "mov",
              "MPEG-4",
              "msf",
              "mtx",
              "mzML",
              "nii",
              "ome-tiff",
              "pdf",
              "plink",
              "png",
              "powerpoint",
              "pzfx",
              "psydat",
              "raw",
              "rds",
              "recal",
              "rmd",
              "sam",
              "sav",
              "sdf",
              "seg",
              "sf",
              "sif",
              "sqlite",
              "sra",
              "svg",
              "svs",
              "tagAlign",
              "tar",
              "tbi",
              "tif",
              "tom",
              "tranches",
              "tsv",
              "txt",
              "vcf",
              "wiggle",
              "xlsx",
              "xml",
              "yaml",
              "h5",
              "wav",
              "zip"
            ]
          },
          {
            "const": ""
          }
        ]
      },
      "title": "File Format",
      "type": "array"
    },
    "fundingReferences": {
      "description": "Funding support information. Format: Funder Name (Award Number)",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "identifier": {
      "description": "Persistent identifier for the dataset (DOI, ARK, Handle). Required for dataset citation and discovery.",
      "type": "string"
    },
    "identifierType": {
      "description": "Type of identifier (DOI, ARK, Handle, URL)",
      "title": "IdentifierTypeEnum",
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "DOI",
            "ARK",
            "Handle",
            "URL",
            "URN",
            "PURL"
          ]
        },
        {
          "const": ""
        }
      ]
    },
    "keywords": {
      "description": "Descriptive keywords or terms for improved search and discovery.",
      "items": {
        "type": "string"
      },
      "title": "Keywords",
      "type": "array"
    },
    "landingPage": {
      "description": "URL to dataset landing page or repository entry",
      "type": "string"
    },
    "license": {
      "description": "Link to a license or name of license applicable for the resource.",
      "title": "License",
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "UNKNOWN",
            "RESTRICTED-USE",
            "Public Domain",
            "CC-0",
            "ODC-PDDL",
            "CC-BY",
            "ODC-BY",
            "ODC-ODbL",
            "CC BY-SA",
            "CC BY-NC",
            "CC BY-ND",
            "CC BY-NC-SA",
            "CC BY-NC-ND"
          ]
        },
        {
          "const": ""
        }
      ]
    },
    "licenseURL": {
      "description": "URL to the full license text",
      "type": "string"
    },
    "originalRepository": {
      "description": "Repository or platform where this data was originally housed before ingestion into the AMP-ALS portal.",
      "items": {
        "description": "Repository or platform where data was originally housed before ingestion into the AMP-ALS portal.",
        "title": "OriginalRepositoryEnum",
        "type": "string",
        "anyOf": [
          {
            "enum": [
              "Synapse",
              "Gene Expression Omnibus",
              "dbGaP",
              "ALS Compute",
              "Critical Path Institute",
              "Target ALS",
              "Sequencing Read Archive",
              "ALL ALS",
              "Linus Health"
            ]
          },
          {
            "const": ""
          }
        ]
      },
      "title": "Original Repository",
      "type": "array"
    },
    "program": {
      "description": "Research consortium(s) or program(s) that produced or funded this resource.",
      "items": {
        "description": "Research consortium or program that produced or funded the dataset.",
        "title": "ProgramEnum",
        "type": "string",
        "anyOf": [
          {
            "enum": [
              "ALS Knowledge Portal",
              "Answer ALS",
              "CReATe Consortium",
              "Genomic Translation for ALS Care (GTAC)",
              "New York Genome Center ALS Consortium",
              "National Institutes of Health",
              "Project MinE",
              "Target ALS",
              "AMP ALS",
              "ALL ALS",
              "Critical Path Institute",
              "ALS Compute"
            ]
          },
          {
            "const": ""
          }
        ]
      },
      "title": "Program",
      "type": "array"
    },
    "publicationYear": {
      "description": "Year the dataset was made publicly available",
      "type": "integer"
    },
    "publisher": {
      "description": "Institution/entity responsible for publishing the dataset",
      "type": "string"
    },
    "relatedDatasets": {
      "description": "Identifiers of related datasets",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "relatedPublications": {
      "description": "Citations or DOIs of related publications",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "resourceType": {
      "description": "General type of the resource (Dataset, Collection, etc.)",
      "title": "ResourceTypeEnum",
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "Dataset",
            "Collection",
            "DataPaper",
            "Software"
          ]
        },
        {
          "const": ""
        }
      ]
    },
    "schemaName": {
      "description": "Name of this metadata schema",
      "type": "string"
    },
    "schemaType": {
      "description": "Type of metadata this schema describes",
      "title": "SchemaTypeEnum",
      "type": "string",
      "anyOf": [
        {
          "enum": [
            "clinical",
            "omics",
            "study",
            "dataset"
          ]
        },
        {
          "const": ""
        }
      ]
    },
    "title": {
      "description": "Title of a resource.",
      "title": "Title",
      "type": "string"
    },
    "version": {
      "description": "Version of this schema (e.g., \"1.0\", \"2.1\")",
      "type": "string"
    }
  },
  "required": [
    "title",
    "originalRepository"
  ]
}
