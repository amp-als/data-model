# Mapping dict: source_column -> target_data_model_field
# Fill in "target" with the data model field name for each column.
# For value-mapped columns, fill in the data model value for each source value.
# Entries with empty string values are ignored during annotation.
{
  # Identifiers are row-level values. Do not map them to an aggregate File
  # annotation; set BiomarkerFile.subjectIdColumn manually to "SampleID".
  "SampleID": "",
  "SubjectID": "",
  "Group": {
    "target": "disease",
    "values": {
      "ALS": "ALS",
      "NA": "",
      "control": "Control"
    }
  },
  # Project encodes the release cohort phase for this bridging study.
  "Project": {
    "target": "studyPhase",
    "values": {
      "bridging sample": "",
      "phase1": "Phase 1",
      "phase2": "Phase 2"
    }
  },
  "Study": {
    "target": "program",
    "values": {
      "AIM": "",
      "ALS Sample Repository": "",
      "ALS Sample Repository\t-\t701008": "",
      "ANSWER ALS": "Answer ALS",
      "Answer ALS": "Answer ALS",
      "BIO_ALS-01": "",
      "BioIVT": "",
      "CABB": "",
      "LABPALS": "",
      "Skin Biopsy": "",
      "Target ALS NHS": "Target ALS"
    }
  },
  # Age, sex, and visit are row-level participant metadata and are not
  # BiomarkerFile annotations. Preserve them in the metadata CSV itself.
  "Age (years)": {
